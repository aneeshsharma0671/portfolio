# Copy to .env.nakama.local and change every value before any shared deployment.

WEB_IMAGE=portfolio-web

NAKAMA_POSTGRES_USER=postgres
NAKAMA_POSTGRES_PASSWORD=replace-with-local-postgres-password
NAKAMA_POSTGRES_PORT=5433

NAKAMA_SOCKET_SERVER_KEY=replace-with-local-nakama-server-key
NAKAMA_SESSION_ENCRYPTION_KEY=replace-with-local-session-encryption-key
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=replace-with-local-refresh-encryption-key
NAKAMA_RUNTIME_HTTP_KEY=replace-with-local-runtime-http-key

NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=replace-with-local-console-password
NAKAMA_HTTP_PORT=7350
NAKAMA_CONSOLE_PORT=7351
NAKAMA_GRPC_PORT=7349

NEXT_PUBLIC_NAKAMA_SERVER_KEY=replace-with-local-nakama-server-key
NEXT_PUBLIC_NAKAMA_HOST=127.0.0.1
NEXT_PUBLIC_NAKAMA_PORT=7350
NEXT_PUBLIC_NAKAMA_USE_SSL=false
